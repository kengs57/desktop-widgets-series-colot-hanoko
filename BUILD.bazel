# Antigravity Bazel Build Targets

package(default_visibility = ["//visibility:public"])

# 파이썬 소스 라이브러리 정의
py_library(
    name = "conyang_lib",
    srcs = glob(["src/*.py"]),
    data = glob([
        "assets/*",
        "sounds/*",
    ]),
)

# 코냥이 위젯 메인 실행 타겟
py_binary(
    name = "conyang_widget",
    srcs = ["src/main.py"],
    main = "src/main.py",
    deps = [
        ":conyang_lib",
    ],
)

# 빌드 및 가상환경 자동 구축 도구 타겟
py_binary(
    name = "build_tool",
    srcs = ["build.py"],
    main = "build.py",
    data = [
        "requirements.txt",
        ":conyang_lib",
    ],
)
